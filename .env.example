# 이 파일을 복사해 .env로 저장하고 실제 값을 채우세요. .env는 git에 커밋하지 않습니다.

# --- 필수: Supabase Auth (로그인) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- 선택: 변경 요약·챗봇을 AI로 생성 (없으면 규칙 기반 요약 사용) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- 선택: 적용 규격 최신판을 구글 검색으로 확인 ---
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- scripts/create-users.mjs 실행 시에만 필요 (관리자/일반 사용자 계정 생성용, 배포된 앱은 사용하지 않음) ---
SUPABASE_SERVICE_ROLE_KEY=
