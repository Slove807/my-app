# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 업로드된 규정 문서 (대외비·개인정보가 있을 수 있어 커밋하지 않는다)
/data

# 삭제 대신 옮겨두는 폴더
/trash-can

# 이 PC에만 해당하는 로컬 설정 (팀과 공유하지 않음)
.claude/settings.local.json

# OCR 언어 데이터 (tesseract.js가 실행 중에 내려받아 캐시한다)
*.traineddata
*.traineddata.gz
